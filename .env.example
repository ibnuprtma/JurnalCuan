# ==============================================================================
# JURNAL CUAN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Auth0 Configuration (Dapatkan dari Auth0 Dashboard > Applications > Settings)
# ------------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# 64 character secret untuk enkripsi session cookie (generate via `openssl rand -hex 32`)
AUTH0_SECRET=your_32_bytes_base64_or_hex_secret_here

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection URL
# ------------------------------------------------------------------------------
# Untuk Local Dev:
DATABASE_URL="postgresql://postgres:admin@localhost:5432/jurnalcuan?schema=public"

# Untuk Docker Compose (Otomatis digunakan di dalam container):
# DATABASE_URL="postgresql://postgres:postgres@db:5432/jurnalcuan?schema=public"
