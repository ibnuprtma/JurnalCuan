# ==============================================================================
# JURNAL CUAN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` dan isi dengan nilai yang sesuai:
#   cp .env.example .env

# Application Environment (development / production)
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Auth0 Configuration (Dapatkan dari Auth0 Dashboard > Applications > Settings)
# Buat aplikasi bertipe "Regular Web Application" di https://manage.auth0.com
# ------------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# 64 character secret untuk enkripsi session cookie
# Generate via terminal: openssl rand -hex 32
AUTH0_SECRET=your_64_char_hex_secret_here

# Auth0 Callback URLs (atur juga di Auth0 Dashboard > Applications > Settings):
#   Allowed Callback URLs:  http://localhost:3000/auth/callback
#   Allowed Logout URLs:    http://localhost:3000
#   Allowed Web Origins:    http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection URL
# ------------------------------------------------------------------------------

# Opsi 1: PostgreSQL Lokal (development)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/jurnalcuan?schema=public"

# Opsi 2: Docker Compose (otomatis digunakan di dalam container, JANGAN aktifkan manual)
# DATABASE_URL="postgresql://postgres:admin@db:5432/jurnalcuan?schema=public"

# Opsi 3: Supabase PostgreSQL (cloud hosted, production-ready)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# ------------------------------------------------------------------------------
# Docker Compose PostgreSQL Settings (hanya digunakan oleh docker-compose.yml)
# Ubah jika ingin menyesuaikan kredensial database container
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=jurnalcuan
