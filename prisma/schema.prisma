datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  WIN
  LOSS
  BREAK_EVEN
}

enum TradingSession {
  ASIAN
  LONDON
  NEW_YORK
  OVERLAP
  OTHER
}

enum SyncMethod {
  MANUAL_ENTRY
  MT5_FILE_IMPORT
  MT5_EA_WEBHOOK
}

model User {
  id            String           @id @default(uuid())
  auth0Id       String           @unique
  email         String           @unique
  name          String?
  username      String?          @unique
  avatarUrl     String?
  bio           String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  accounts      TradingAccount[]
  customTags    CustomTag[]
  strategies    Strategy[]
  userRules     TradingRule[]

  @@index([auth0Id])
}

model TradingAccount {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  broker             String?
  accountNumber      String?
  accountType        String      @default("Real")
  initialBalance     Decimal     @default(0.0) @db.Decimal(15, 2)
  currentBalance     Decimal     @default(0.0) @db.Decimal(15, 2)
  currency           String      @default("USD")
  isArchived         Boolean     @default(false)
  isPublic           Boolean     @default(false)
  publicSlug         String?     @unique
  hideDollarAmounts  Boolean     @default(false)
  webhookApiKey      String?     @unique @default(uuid())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  trades             Trade[]

  @@index([userId])
}

model Trade {
  id               String          @id @default(uuid())
  accountId        String
  account          TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticketId         String?         @unique
  pair             String
  direction        TradeDirection
  session          TradingSession  @default(OTHER)
  openTime         DateTime
  closeTime        DateTime?
  lotSize          Decimal         @db.Decimal(10, 2)
  entryPrice       Decimal         @db.Decimal(15, 5)
  exitPrice        Decimal?        @db.Decimal(15, 5)
  stopLoss         Decimal?        @db.Decimal(15, 5)
  takeProfit       Decimal?        @db.Decimal(15, 5)
  commission       Decimal         @default(0.0) @db.Decimal(10, 2)
  swap             Decimal         @default(0.0) @db.Decimal(10, 2)
  grossPnL         Decimal         @default(0.0) @db.Decimal(15, 2)
  netPnL           Decimal         @default(0.0) @db.Decimal(15, 2)
  netPips          Decimal         @default(0.0) @db.Decimal(10, 1)
  riskRewardRatio  Decimal?        @db.Decimal(6, 2)
  status           TradeStatus     @default(OPEN)
  syncMethod       SyncMethod      @default(MANUAL_ENTRY)
  screenshotUrl    String?
  notes            String?
  emotionTag       String?
  mistakeTag       String?
  isNewsTrade      Boolean         @default(false)
  strategyId       String?
  strategy         Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([accountId])
  @@index([openTime])
  @@index([pair])
}

model Strategy {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#10b981")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trades      Trade[]

  @@unique([userId, name])
}

model CustomTag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String   @default("EMOTION")
  color     String   @default("#64748b")
  createdAt DateTime @default(now())

  @@unique([userId, name, category])
}

model TradingRule {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
